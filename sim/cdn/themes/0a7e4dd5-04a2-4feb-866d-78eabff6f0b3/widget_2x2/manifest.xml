<?xml version="1.0" encoding="utf-8"?><Widget version="1" disableCutRoundCorner="false" frameRate="0" useVariableUpdater="DateTime.Minute" screenWidth="1080"><ExternalCommands><Trigger action="init,resume"><VariableCommand name="filePath" type="string" expression="ifelse(#month == 0 ** #date {= 5, 'yuandan', eqs(formatDate('N月e', #time_sys + 86400000), '正月初一') || (#month_lunar == 0 ** #date_lunar {= 15), 'chunjie', (#month_lunar == 4 ** (#date_lunar }= 5 ** #date_lunar {= 7)), 'duanwujie', 'normal')"/><VariableCommand name="resourceId" type="number" expression="0"/><VariableCommand name="imgPath" type="string" expression="@filePath + '/' + @mode + '/0/bg.webp'"/><FunctionCommand target="PLAY_ANIMATION"/></Trigger><Trigger action="pause"><FrameRateCommand rate="1"/><AnimationCommand target="ani" command="play(0, 0)"/></Trigger></ExternalCommands><Var name="modeNum" expression="!(#hour24 }= 7 ** #hour24 {= 21)"><Trigger><IfCommand ifCondition="#ani == 0"><Consequent><FunctionCommand target="SWITCH_RESOURCES"/></Consequent><Alternate><VariableCommand name="loop" type="number" expression="1"/></Alternate></IfCommand></Trigger></Var><Function name="SWITCH_RESOURCES"><VariableCommand name="loop" type="number" expression="0"/><FrameRateCommand rate="60"/><IfCommand ifCondition="#modeNum"><Consequent><VariableCommand name="imgPath" type="string" expression="@filePath + '/light/0/bg.webp'"/><AnimationCommand target="ani" command="play" tags="aniC"/></Consequent><Alternate><VariableCommand name="imgPath" type="string" expression="@filePath + '/dark/0/bg.webp'"/><AnimationCommand target="ani" command="play" tags="aniD"/></Alternate></IfCommand></Function><Var name="mode" type="string" expression="ifelse(#hour24 }= 7 ** #hour24 {= 21, 'light', 'dark')"/><Function name="PLAY_ANIMATION"><FrameRateCommand rate="60"/><VariableCommand name="numberOfDocuments" type="number" expression="ifelse(
