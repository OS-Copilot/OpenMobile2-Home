<?xml version="1.0" encoding="utf-8"?>
<Clock frameRate="30" resDensity="480" type="awesome" scaleByDensity="false" screenWidth="1080" type="awesome" useVariableUpdater="Battery,DateTime.Minute" version="1">
<VariableBinders>
<ContentProviderBinder columns="city_id,city_name,weather_type,aqilevel,description,temperature,forecast_type,tmphighs,tmplows,wind,humidity,sunrise,sunset,pressure,weathernamesfrom,forecast_type,publish_time" countName="hasweather" name="WeatherProvider" uri="content://weather/actualWeatherData/1">
<Variable column="city_id" name="weather_city_id" type="string"/>
<Variable column="city_name" name="weather_location" type="string"/>
<Variable column="weather_type" name="weather_id" type="int"/>
<Variable column="temperature" name="weather_temperature" type="string"/>
<Variable column="aqilevel" name="weather_aqi" type="int"/>
<Variable column="sunrise" name="weather_sunrise" type="int"/>
<Variable column="sunset" name="weather_sunset" type="int"/>
<Variable column="forecast_type" name="weather_forecast_type" type="int"/>
<Variable column="wind" name="weather_wind" type="string"/>
<Variable column="pressure" name="weather_pressure" type="int"/>
<Variable column="humidity" name="weather_humidity" type="int"/>
<Variable column="weather_type" name="weather_type" type="string[]"/>
<Variable column="description" name="weather_description" type="string"/>
<Variable column="weathernamesfrom" name="weather_weathernamesfrom" type="string[]"/>
<Variable column="tmphighs" name="weather_temphigh" type="string[]"/>
<Variable column="tmplows" name="weather_templow" type="string[]"/>
<Variable column="publish_time" name="weather_publish_time" type="string"/>
<Trigger>
<VariableCommand expression="ifelse(#weather_aqi }= 0 ** #weather_aqi {= 50,&apos;空气优&apos;,#weather_aqi}50 ** #weather_aqi {= 100,&apos;空气良好&apos;,#weather_aqi}100 ** #weather_aqi {= 150,&apos;轻度污染&apos;,#weather_aqi}150 ** #weather_aqi {= 200,&apos;中度污染&apos;,#weather_aqi}200 ** #weather_aqi {= 300,&apos;严重污染&apos;,#weather_aqi}300,&apos;重度污染&apos;,&apos;获取信息异常&apos;)" name="weather_air_quality" type="string"/>
<VariableCommand expression="ifelse(#weather_id}25 || #weather_id{0,0, (#weather_id }= 4 ** #weather_id {= 6 || #weather_id }= 8 ** #weather_id {= 11 || #weather_id == 25),4,#weather_id }= 13 ** #weather_id {= 17,13 ,#weather_id }= 18 ** #weather_id {= 21 || #weather_id == 23,18,#weather_id)" name="weatherId"/>
<VariableCommand expression="90*(((#hour24-8)*3600000+#minute*60000+#second*1000)/#weather_sunset)-45" name="weather_sun_rotation"/>
<VariableCommand expression="max(min(#weather_sun_rotation,45),-45)+45" name="weather_rot_angle"/>
</Trigger>
</ContentProviderBinder>
<ContentProviderBinder columns="aqi,pm25,pm10,so2,no2" countName="hasweatherinfo" dependency="WeatherProvider" uriFormat="content://weatherinfo/aqi/%s" uriParas="@weather_city_id">
<Variable column="pm25" name="weather_pm25" type="int"/>
<Variable column="no2" name="weather_no2" type="int"/>
<Variable column="pm10" name="weather_pm10" type="int"/>
<Variable column="so2" name="weather_so2" type="int"/>
</ContentProviderBinder>
<ContentProviderBinder columns="status" countName="hasResult" name="CountService" uriFormat="content://com.miui.maml.provider/analytics/%s" uriParas="@countParas"/>
<!--计步-->
<ContentProviderBinder name="MiSteps" uri="content://com.mi.health.provider.main/activity/steps/brief" column="steps,goal,distance,energy,strength_duration,summary" countName="hasSteps" >
<Variable name="MiSteps_steps" type="string" column="steps"/>
<Variable name="MiSteps_goal" type="string" column="goal"/>
<Variable name="MiSteps_distance" type="string" column="distance"/>
<Variable name="MiSteps_energy" type="string" column="energy"/>
<Variable name="MiSteps_strength_duration" type="string" column="strength_duration"/>
<Variable name="MiSteps_summary" type="string" column="summary"/>
</ContentProviderBinder>
</VariableBinders>

<Var expression="#view_width" name="sw"/>
<Var expression="#view_height" name="sh"/>
<Var expression="#view_width/2" name="sw/2"/>
<Var expression="#view_height/2" name="sh/2"/>

<Var expression="ifelse(#applied_light_wallpaper,'#cc000000','#ffffff')" type="string" name="allcolortext"/>
<VarArray type="string">
<Vars>
<Var index="#ampm" name="time_ampm"/>
</Vars>
<Items>
<Item value="AM"/>
<Item value="PM"/>
</Items>
